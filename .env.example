# Copy this file to .env and enter local secrets. Do not commit .env.
# Spring Profile. local-test 고정 access token은 이 값이 반드시 local-test여야 활성화됩니다.
SPRING_PROFILES_ACTIVE=local
MOCA_PROFILE=local
# Tomcat에서 프로젝트 외부 .env를 사용할 때만 절대 경로를 설정합니다.
MOCA_ENV_FILE=

# MySQL
MOCA_DB_NAME=
MOCA_DB_PORT=
MOCA_DB_URL=
MOCA_DB_USERNAME=
MOCA_DB_PASSWORD=
MOCA_DB_ROOT_PASSWORD=
MOCA_DB_POOL_MAX_SIZE=10
MOCA_DB_POOL_MIN_IDLE=2
MOCA_DB_POOL_CONNECTION_TIMEOUT_MS=3000

# Redis
MOCA_REDIS_HOST=
MOCA_REDIS_PORT=
MOCA_REDIS_PASSWORD=
# Redis database index. local-test는 기본값으로 1을 사용하며, 일반 local/배포 환경은 0을 사용합니다.
MOCA_REDIS_DATABASE=

# MOCA opaque token expiration (seconds)
MOCA_ACCESS_TOKEN_TTL_SECONDS=
MOCA_REFRESH_TOKEN_TTL_SECONDS=
# local HTTP에서는 false, HTTPS 배포 환경에서는 true를 사용합니다.
MOCA_REFRESH_COOKIE_SECURE=

# Google OAuth: backend ID-token audience validation
MOCA_GOOGLE_CLIENT_ID=

# CODEF API
MOCA_CODEF_CLIENT_ID=
MOCA_CODEF_CLIENT_SECRET=
MOCA_CODEF_PUBLIC_KEY=
MOCA_CODEF_BASE_URL=https://development.codef.io
MOCA_CODEF_TOKEN_URL=https://oauth.codef.io/oauth/token

# Sensitive credential encryption and opaque-token hashing
# MOCA_CREDENTIAL_ENCRYPTION_KEY: Base64-encoded 32-byte AES key
# MOCA_CREDENTIAL_FINGERPRINT_KEY: Base64-encoded 32-byte HMAC key, encryption key와 분리
# MOCA_TOKEN_HASH_PEPPER: independently generated high-entropy random value
MOCA_CREDENTIAL_ENCRYPTION_KEY=
MOCA_CREDENTIAL_FINGERPRINT_KEY=
MOCA_TOKEN_HASH_PEPPER=

# Local API test only. Set SPRING_PROFILES_ACTIVE=local-test to enable this mode.
# MOCA_PROFILE도 local-test로 맞추면 refresh cookie가 Secure=false로 설정됩니다.
# The raw token below is never stored in Redis; only its hash is stored and only this exact token is accepted.
# MOCA_LOCAL_TEST_ACCESS_TOKEN=
# MOCA_LOCAL_TEST_USER_ID=an-existing-user-uuid
# MOCA_LOCAL_TEST_USER_TYPE=user
