# Copy this file to .env and enter local secrets. Do not commit .env.
# Spring Profile
SPRING_PROFILES_ACTIVE=local
MOCA_PROFILE=local
# Tomcat에서 프로젝트 외부 .env를 사용할 때만 절대 경로를 설정합니다.
MOCA_ENV_FILE=
# docker-compose.prod.yml에서 컨테이너에 주입할 env 파일 경로입니다. 기본값은 /home/ec2-user/moca/.env입니다.
MOCA_SERVICE_ENV_FILE=

# MySQL
MOCA_DB_NAME=
MOCA_DB_PORT=
MOCA_DB_URL=
MOCA_DB_USERNAME=
MOCA_DB_PASSWORD=
MOCA_DB_ROOT_PASSWORD=
MOCA_DB_POOL_MAX_SIZE=10
MOCA_DB_POOL_MIN_IDLE=2
MOCA_DB_POOL_CONNECTION_TIMEOUT_MS=3000

# Redis
MOCA_REDIS_HOST=
MOCA_REDIS_PORT=
MOCA_REDIS_PASSWORD=
# Redis database index. 기본값은 0입니다.
MOCA_REDIS_DATABASE=

# MOCA opaque token expiration (seconds)
MOCA_ACCESS_TOKEN_TTL_SECONDS=
MOCA_REFRESH_TOKEN_TTL_SECONDS=
# local HTTP에서는 false, HTTPS 배포 환경에서는 true를 사용합니다.
MOCA_REFRESH_COOKIE_SECURE=

# Google OAuth: authorization code 교환 및 Google 프로필 이름 조회
MOCA_GOOGLE_CLIENT_ID=
MOCA_GOOGLE_REQUIRED_SCOPES=openid,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile

# CODEF API
MOCA_CODEF_CLIENT_ID=
MOCA_CODEF_CLIENT_SECRET=
MOCA_CODEF_PUBLIC_KEY=
MOCA_CODEF_BASE_URL=https://development.codef.io
MOCA_CODEF_TOKEN_URL=https://oauth.codef.io/oauth/token
MOCA_CODEF_CONNECT_TIMEOUT_MS=3000
MOCA_CODEF_REQUEST_TIMEOUT_MS=30000

# Kakao
MOCA_KAKAO_REST_API_KEY=


# Firebase Cloud Messaging
# 외부 Tomcat은 서비스 계정 JSON의 절대 경로를 GOOGLE_APPLICATION_CREDENTIALS에 설정합니다.
GOOGLE_APPLICATION_CREDENTIALS=
# docker-compose.prod.yml이 읽을 호스트의 서비스 계정 JSON 절대 경로입니다.
MOCA_FIREBASE_CREDENTIALS_FILE=

# Sensitive credential encryption and opaque-token hashing
# MOCA_CREDENTIAL_ENCRYPTION_KEY: Base64-encoded 32-byte AES key
# MOCA_CREDENTIAL_HASH_KEY: Base64-encoded 32-byte HMAC key, encryption key와 분리 (중복 연동 식별 해시·CODEF 카드 키 해시에 사용)
# MOCA_TOKEN_HASH_PEPPER: independently generated high-entropy random value
MOCA_CREDENTIAL_ENCRYPTION_KEY=
MOCA_CREDENTIAL_HASH_KEY=
MOCA_TOKEN_HASH_PEPPER=
