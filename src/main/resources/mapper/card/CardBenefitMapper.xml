<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moca.mocabe.domain.card.mapper.CardBenefitMapper">

    <resultMap id="cardBenefitRowResultMap" type="com.moca.mocabe.domain.card.model.CardBenefitRow">
        <id property="benefitId" column="benefit_id"/>
        <result property="recordType" column="record_type"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="detailText" column="detail_text"/>
        <result property="detailHtml" column="detail_html"/>
    </resultMap>

    <select id="findByContentVersionId" resultMap="cardBenefitRowResultMap">
        SELECT
            benefit_id,
            record_type,
            title,
            summary,
            detail_text,
            detail_html
        FROM card_benefits
        WHERE content_version_id = #{contentVersionId}
            AND record_type IN ('benefit', 'notice')
        ORDER BY position ASC
    </select>
</mapper>
