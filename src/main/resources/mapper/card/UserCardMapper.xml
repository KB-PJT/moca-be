<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moca.mocabe.domain.card.mapper.UserCardMapper">

    <resultMap id="userCardListRowResultMap" type="com.moca.mocabe.domain.card.model.UserCardListRow">
        <id property="userCardId" column="user_card_id"/>
        <result property="cardName" column="card_name"/>
        <result property="cardNo" column="card_no"/>
        <result property="issuerId" column="issuer_id"/>
        <result property="issuerName" column="issuer_name"/>
        <result property="cardImageUrl" column="card_image_url"/>
        <result property="memo" column="memo"/>
        <result property="contentVersionId" column="content_version_id"/>
    </resultMap>

    <sql id="userCardColumns">
        uc.user_card_id,
        COALESCE(cv.name, uc.card_name_from_codef) AS card_name,
        uc.card_no,
        i.issuer_id,
        i.issuer_name,
        NULLIF(cv.image_url, '') AS card_image_url,
        uc.memo,
        cv.content_version_id
    </sql>

    <!-- 카드별 최신 콘텐츠 버전(가장 최근 last_seen_at, 동률이면 content_version_id 큰 것)만 연결한다. -->
    <sql id="userCardJoins">
        INNER JOIN issuers i ON i.issuer_id = uc.issuer_id
        INNER JOIN cards c ON c.card_id = uc.card_id
        LEFT JOIN card_content_versions cv ON cv.card_id = c.card_id
            AND NOT EXISTS (
                SELECT 1 FROM card_content_versions cv2
                WHERE cv2.card_id = cv.card_id
                  AND (cv2.last_seen_at > cv.last_seen_at
                       OR (cv2.last_seen_at = cv.last_seen_at
                           AND cv2.content_version_id > cv.content_version_id))
            )
    </sql>

    <sql id="userCardCondition">
        uc.user_id = #{userId}
    </sql>

    <select id="findActiveByUserId" resultMap="userCardListRowResultMap">
        SELECT
            <include refid="userCardColumns"/>
        FROM user_cards uc
        <include refid="userCardJoins"/>
        WHERE
            <include refid="userCardCondition"/>
            AND uc.is_active = TRUE
        ORDER BY uc.display_order ASC, uc.user_card_id ASC
    </select>

    <select id="findInactiveByUserId" resultMap="userCardListRowResultMap">
        SELECT
            <include refid="userCardColumns"/>
        FROM user_cards uc
        <include refid="userCardJoins"/>
        WHERE
            <include refid="userCardCondition"/>
            AND uc.is_active = FALSE
        ORDER BY uc.display_order ASC, uc.user_card_id ASC
    </select>

    <select id="findHomeCardsByUserId" resultMap="userCardListRowResultMap">
        SELECT
            <include refid="userCardColumns"/>
        FROM user_cards uc
        <include refid="userCardJoins"/>
        WHERE
            <include refid="userCardCondition"/>
            AND uc.is_active = TRUE
        <choose>
            <when test="orderMode == 'AUTO'">
                ORDER BY uc.display_order ASC, uc.user_card_id ASC
            </when>
            <otherwise>
                ORDER BY uc.display_order ASC, uc.user_card_id ASC
            </otherwise>
        </choose>
    </select>

    <select id="existsByUserId" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM user_cards uc
            WHERE <include refid="userCardCondition"/>
        )
    </select>

    <select id="findByUserCardId" resultMap="userCardListRowResultMap">
        SELECT
            <include refid="userCardColumns"/>
        FROM user_cards uc
        <include refid="userCardJoins"/>
        WHERE uc.user_card_id = #{userCardId}
            AND <include refid="userCardCondition"/>
    </select>

    <update id="updateMemo">
        UPDATE user_cards
        SET memo = #{memo},
            updated_at = UTC_TIMESTAMP(6)
        WHERE user_card_id = #{userCardId}
            AND user_id = #{userId}
    </update>

    <!-- 카드 연결 해제 시 user_cards를 참조하는 자식 테이블부터 순차적으로 삭제한다. -->
    <delete id="deleteBenefitCalculationOutcomesByUserCardId">
        DELETE FROM user_benefit_calculation_outcomes WHERE user_card_id = #{userCardId}
    </delete>

    <delete id="deleteBenefitUsagesByUserCardId">
        DELETE FROM user_benefit_usages WHERE user_card_id = #{userCardId}
    </delete>

    <delete id="deleteOptionSelectionsByUserCardId">
        DELETE FROM user_card_option_selections WHERE user_card_id = #{userCardId}
    </delete>

    <delete id="deletePerformanceSnapshotsByUserCardId">
        DELETE FROM user_card_performance_snapshots WHERE user_card_id = #{userCardId}
    </delete>

    <delete id="deletePaymentApprovalsByUserCardId">
        DELETE FROM card_payment_approvals WHERE user_card_id = #{userCardId}
    </delete>

    <delete id="deleteUserCard">
        DELETE FROM user_cards
        WHERE user_card_id = #{userCardId}
            AND user_id = #{userId}
    </delete>

    <update id="deactivateUserCard">
        UPDATE user_cards
        SET is_active = FALSE,
            updated_at = UTC_TIMESTAMP(6)
        WHERE user_card_id = #{userCardId}
            AND user_id = #{userId}
    </update>

    <!-- userCardIds의 목록 내 위치를 새 display_order로 저장한다. -->
    <update id="updateDisplayOrders">
        UPDATE user_cards
        SET display_order = CASE user_card_id
            <foreach collection="userCardIds" item="userCardId" index="displayOrder">
                WHEN #{userCardId} THEN #{displayOrder}
            </foreach>
            ELSE display_order
            END,
            updated_at = UTC_TIMESTAMP(6)
        WHERE user_id = #{userId}
            AND user_card_id IN
            <foreach collection="userCardIds" item="userCardId" open="(" separator="," close=")">
                #{userCardId}
            </foreach>
    </update>
</mapper>
