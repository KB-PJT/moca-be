<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moca.mocabe.domain.support.mapper.SupportInquiryMapper">

    <resultMap id="inquiryRowResultMap" type="com.moca.mocabe.domain.support.model.InquiryRow">
        <id property="inquiryId" column="inquiry_id"/>
        <result property="inquiryType" column="inquiry_type"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="replyEmail" column="reply_email"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="answeredAt" column="answered_at"/>
    </resultMap>

    <insert id="insertInquiry">
        INSERT INTO support_inquiries (
            inquiry_id,
            user_id,
            inquiry_type,
            title,
            content,
            reply_email,
            status,
            created_at
        ) VALUES (
            #{inquiryId},
            #{userId},
            #{inquiryType},
            #{title},
            #{content},
            #{replyEmail},
            'received',
            UTC_TIMESTAMP(6)
        )
    </insert>

    <select id="findByInquiryId" resultMap="inquiryRowResultMap">
        SELECT inquiry_id, inquiry_type, title, content, reply_email, status, created_at, answered_at
        FROM support_inquiries
        WHERE inquiry_id = #{inquiryId} AND user_id = #{userId}
    </select>

    <delete id="deleteByUserId">
        DELETE FROM support_inquiries WHERE user_id = #{userId}
    </delete>
</mapper>
