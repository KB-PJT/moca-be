<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moca.mocabe.domain.merchant.mapper.MerchantCategoryMapper">

    <resultMap id="merchantCategoryRowMap" type="com.moca.mocabe.domain.merchant.model.MerchantCategoryRow">
        <constructor>
            <arg column="merchant_category_id" javaType="java.lang.String"/>
            <arg column="category_code" javaType="java.lang.String"/>
            <arg column="category_name" javaType="java.lang.String"/>
            <arg column="display_order" javaType="_int"/>
        </constructor>
    </resultMap>

    <!-- kakao_category_maps에 활성 매핑이 없는 카테고리(간편결제/OTT 등 물리적 위치가 없는 카테고리)는
         지도에서 검색할 방법이 없으므로 제외한다. -->
    <select id="findAllOrderedByDisplayOrder" resultMap="merchantCategoryRowMap">
        SELECT mc.merchant_category_id, mc.category_code, mc.category_name, mc.display_order
        FROM merchant_categories mc
        WHERE EXISTS (
            SELECT 1 FROM kakao_category_maps k
            WHERE k.merchant_category_id = mc.merchant_category_id AND k.enabled = TRUE
        )
        ORDER BY mc.display_order ASC
    </select>
</mapper>
