<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.moca.mocabe.domain.merchant.mapper.MerchantCategoryMapper">

    <resultMap id="merchantCategoryRowMap" type="com.moca.mocabe.domain.merchant.model.MerchantCategoryRow">
        <constructor>
            <arg column="merchant_category_id" javaType="java.lang.String"/>
            <arg column="category_code" javaType="java.lang.String"/>
            <arg column="category_name" javaType="java.lang.String"/>
            <arg column="display_order" javaType="_int"/>
        </constructor>
    </resultMap>

    <select id="findAllOrderedByDisplayOrder" resultMap="merchantCategoryRowMap">
        SELECT merchant_category_id, category_code, category_name, display_order
        FROM merchant_categories
        WHERE is_map_visible = TRUE
        ORDER BY display_order ASC
    </select>
</mapper>
