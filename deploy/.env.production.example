# 이 파일을 /home/ec2-user/moca/.env로 복사한 후 실제 값을 채운다.
# 실제 .env는 EC2에만 두고 Git에 커밋하지 않는다.

# MySQL (Amazon RDS)
MOCA_DB_URL=jdbc:mysql://<rds-endpoint>:3306/moca?useSSL=true&serverTimezone=UTC
MOCA_DB_USERNAME=moca_admin
MOCA_DB_PASSWORD=
MOCA_DB_POOL_MAX_SIZE=10
MOCA_DB_POOL_MIN_IDLE=2
MOCA_DB_POOL_CONNECTION_TIMEOUT_MS=3000

# Redis (Amazon ElastiCache Redis OSS)
MOCA_REDIS_HOST=<elasticache-primary-endpoint>
MOCA_REDIS_PORT=6379
MOCA_REDIS_PASSWORD=
MOCA_REDIS_DATABASE=0

# OAuth and opaque-token security
MOCA_GOOGLE_CLIENT_ID=
MOCA_ACCESS_TOKEN_TTL_SECONDS=1800
MOCA_REFRESH_TOKEN_TTL_SECONDS=1209600
MOCA_TOKEN_HASH_PEPPER=
